{
  "brand": {
    "nome": "KORTEX",
    "tagline": "la corteccia delle tue IA",
    "colori": [
      "#9D4EDD",
      "#FF2BD6",
      "#00F5FF"
    ]
  },
  "autonomia": "prudente",
  "mappa": "STANDARD",
  "maxCompiti": 3,
  "usaPianificatore": true,
  "usaRevisore": true,
  "revisoreIndipendente": true,
  "memoriaRighe": 30,
  "animazioni": "piena",
  "tema": "neon",
  "memoriaAutomatica": true,
  "timeoutSecondi": 900,
  "silenzioSecondi": 300,
  "maxCorrezioni": 1,
  "ruoli": {
    "direttore": [
      "claude",
      "codex",
      "gemini",
      "ollama"
    ],
    "pianificatore": [
      "claude",
      "codex",
      "gemini",
      "ollama"
    ],
    "esecutore": [
      "claude",
      "codex"
    ],
    "operatore": [
      "claude",
      "codex"
    ],
    "revisore": [
      "codex",
      "claude",
      "gemini",
      "ollama"
    ],
    "catalogatore": [
      "claude",
      "codex",
      "gemini",
      "ollama"
    ],
    "memorista": [
      "claude",
      "codex",
      "gemini",
      "ollama"
    ]
  },
  "ia": {
    "claude": {
      "nome": "Claude",
      "bin": "claude",
      "args": [
        "-p",
        "{prompt}",
        "--output-format",
        "stream-json",
        "--verbose",
        "--include-partial-messages",
        "{resume}",
        "{adddir}",
        "{extra}"
      ],
      "resume": [
        "--resume",
        "{session}"
      ],
      "parser": "claude-stream",
      "puntiForti": "ragionamento, codice complesso, modifiche coordinate su più file"
    },
    "codex": {
      "nome": "Codex",
      "bin": "codex",
      "args": [
        "exec",
        "--skip-git-repo-check",
        "{extra}",
        "{prompt}"
      ],
      "parser": "testo",
      "puntiForti": "scrittura di codice e script, correzioni mirate"
    },
    "gemini": {
      "nome": "Gemini",
      "bin": "gemini",
      "args": [
        "{extra}",
        "-p",
        "{prompt}"
      ],
      "parser": "testo",
      "puntiForti": "analisi di testi e progetti grandi, revisione"
    },
    "ollama": {
      "nome": "Ollama",
      "bin": "ollama",
      "args": [
        "run",
        "{modello}",
        "{prompt}"
      ],
      "parser": "testo",
      "modello": "auto",
      "puntiForti": "compiti semplici, funziona senza internet"
    }
  },
  "profili": {
    "lettura": {
      "claude": [],
      "codex": [
        "--sandbox",
        "read-only"
      ],
      "gemini": [],
      "ollama": []
    },
    "prudente": {
      "claude": [
        "--permission-mode",
        "acceptEdits"
      ],
      "codex": [
        "--sandbox",
        "workspace-write"
      ],
      "gemini": [],
      "ollama": []
    },
    "totale": {
      "claude": [
        "--dangerously-skip-permissions"
      ],
      "codex": [
        "--dangerously-bypass-approvals-and-sandbox"
      ],
      "gemini": [
        "--yolo"
      ],
      "ollama": []
    },
    "operatore": {
      "claude": [
        "--permission-mode",
        "acceptEdits",
        "--allowedTools",
        "Bash"
      ],
      "codex": [
        "--sandbox",
        "workspace-write"
      ],
      "gemini": [],
      "ollama": []
    },
    "verifica": {
      "claude": [
        "--allowedTools",
        "Bash"
      ],
      "codex": [
        "--sandbox",
        "workspace-write"
      ],
      "gemini": [],
      "ollama": []
    }
  },
  "versioneConfig": 3,
  "parallelo": 2,
  "revisoreVerifica": true,
  "grafica": "auto",
  "suoni": true,
  "mouse": true,
  "icone": "auto",
  "bolle": true,
  "profilo": null
}
